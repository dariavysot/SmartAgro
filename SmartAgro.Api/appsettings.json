{
  "DatabaseProvider": "PostgreSql",
  "ConnectionStrings": {
    "PostgreSql": "",
    "Sqlite": "Data Source=smartagro.db"
  },
  "SimulatorSettings": {
    "IntervalMinutes": 2,
    "EnableAnomalies": true
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "SmartAgro.Api",
    "Audience": "SmartAgro.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "CryptoSettings": {
    "AesKeyBase64": "",
    "HmacKeyBase64": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}