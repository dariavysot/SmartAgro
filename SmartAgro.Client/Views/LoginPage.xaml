<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartAgro.Client.ViewModels"
             x:Class="SmartAgro.Client.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="🌱 SmartAgro"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />

            <Label Text="Вхід до системи моніторингу"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="Gray" />

            <Border StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15,0">
                <Entry Text="{Binding Email}"
                       Placeholder="Email"
                       Keyboard="Email" />
            </Border>

            <Border StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15,0">
                <Entry Text="{Binding Password}"
                       Placeholder="Пароль"
                       IsPassword="True" />
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Увійти"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HeightRequest="50"
                    CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>