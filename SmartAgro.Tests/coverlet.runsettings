<runsettings>
  <dataCollectionRunSettings>
    <dataCollectors>
      <dataCollector friendlyName="XPlat Code Coverage">
        <configuration>
          <Format>cobertura</Format>
          <Exclude>
            [SmartAgro.Core]SmartAgro.Core.Migrations.*,
            [SmartAgro.Core]SmartAgro.Core.Data.*ModelSnapshot*
          </Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </configuration>
      </dataCollector>
    </dataCollectors>
  </dataCollectionRunSettings>
</runsettings>